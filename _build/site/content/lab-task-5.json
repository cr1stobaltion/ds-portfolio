eE0sgXxp"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Create a NumPy array called \"arr\" that contains 6 random integers between 0 (inclusive) and 5 (exclusive), call the ","key":"XNfiSWsaE6"},{"type":"inlineCode","value":"set_seed()","key":"cZj8HG9142"},{"type":"text","value":" function and use ","key":"e88BjfskRs"},{"type":"inlineCode","value":"42","key":"RBSnjLhyTy"},{"type":"text","value":" as the seed parameter.","key":"V0ApJqiGbF"}],"key":"YDx1qk96lF"}],"key":"DXeosrRRTm"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Create a tensor \"x\" from the array above","key":"u4ko1xcDhJ"}],"key":"iNl2g7Cr4o"}],"key":"gerf5MMFeF"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Change the dtype of x from ","key":"Qf4549c5Pz"},{"type":"inlineCode","value":"int32","key":"XOcB1Fn1fB"},{"type":"text","value":" to ","key":"HfYznoZc1J"},{"type":"inlineCode","value":"int64","key":"MB4yl3XlxM"}],"key":"d8MkTnzFPw"}],"key":"J9yW3OwaBn"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Reshape ","key":"YVJJ7UsF1K"},{"type":"inlineCode","value":"x","key":"z67VbNvAVf"},{"type":"text","value":" into a 3x2 tensor","key":"sfcXw7ic2E"}],"key":"HkPxPSqWRx"}],"key":"uJ8RgXZbiu"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Return the right-hand column of tensor ","key":"ZJWYV3VSDe"},{"type":"inlineCode","value":"x","key":"DXkCW2AaQ1"}],"key":"oUgPekSgAF"}],"key":"cf2s6eii0t"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Without changing x, return a tensor of square values of ","key":"hppuwPEF8U"},{"type":"inlineCode","value":"x","key":"u2SN8xwcyE"}],"key":"vl5UNdN3EJ"}],"key":"k1VYCCtSWB"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Create a tensor ","key":"SKMWqy3kK0"},{"type":"inlineCode","value":"y","key":"B58uXBrrjW"},{"type":"text","value":" with the same number of elements as ","key":"IppH4pXf1T"},{"type":"inlineCode","value":"x","key":"spHEKofdcG"},{"type":"text","value":", that can be matrix-multiplied with ","key":"ZLd2uIXttp"},{"type":"inlineCode","value":"x","key":"yjixkUmSQY"},{"type":"text","value":" (seed 42)","key":"uNBUYySLQ3"}],"key":"slSPKpp5Fp"}],"key":"cLQV5XGyKp"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Find the matrix product of ","key":"Q9bZ1aterI"},{"type":"inlineCode","value":"x","key":"ZJpgSWcjuN"},{"type":"text","value":" and ","key":"pGugvF6VJA"},{"type":"inlineCode","value":"y","key":"FPhshd74RN"},{"type":"text","value":".","key":"opLnGa4orP"}],"key":"qxAjirYlqL"}],"key":"CU9tk5KAvy"}],"key":"REUQ916tag"}],"key":"YtRIln2ymO"},{"type":"heading","depth":2,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Code Implementation","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"Ptgk8qNnKl"}],"identifier":"code-implementation","label":"Code Implementation","html_id":"code-implementation","implicit":true,"key":"vFfAXMnpY8"}],"key":"BQAXlGBPd1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 1. Perform Standard Imports\nimport torch\nimport numpy as np\n\n# 2. Create set_seed() function\ndef set_seed(seed: int):\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n\n# 3. Create a NumPy array 'arr' of 6 random integers between 0 and 5\nset_seed(42)\narr = np.random.randint(0, 5, 6)\nprint(\"3. NumPy array 'arr':\", arr)\n\n# 4. Create tensor x from array\nx = torch.from_numpy(arr)\nprint(\"4. Tensor x:\", x)\n\n# 5. Change dtype of x from int32 to int64\nprint(\"5. Old Type:\", x.type())\nx = x.type(torch.int64)\nprint(\"   New Type:\", x.type())\n\n# 6. Reshape x into a 3x2 tensor\nx = x.reshape(3, 2)\nprint(\"6. Reshaped x (3x2):\\n\", x)\n\n# 7. Return the right-hand column of tensor x\nprint(\"7. Right-hand column:\\n\", x[:, 1:])\n\n# 8. Without changing x, return a tensor of square values of x\nx_squared = x.pow(2)\nprint(\"8. Squared values:\\n\", x_squared)\nprint(\"   Original x unchanged:\\n\", x)\n\n# 9. Create tensor y with shape (2, 3) to permit matrix multiplication with x (3, 2)\nset_seed(42)\ny = torch.randint(0, 5, (2, 3))\nprint(\"9. Tensor y (2x3):\\n\", y)\n\n# 10. Find the matrix product of x and y.\nprod = torch.mm(x, y)\nprint(\"10. Matrix product prod (3x3):\\n\", prod)","key":"Q6opAVOQlp"},{"type":"outputs","id":"p7dxxYTVed00BxIl2dEKI","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"3. NumPy array 'arr': [3 4 2 4 4 1]\n4. Tensor x: tensor([3, 4, 2, 4, 4, 1], dtype=torch.int32)\n5. Old Type: torch.IntTensor\n   New Type: torch.LongTensor\n6. Reshaped x (3x2):\n tensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n7. Right-hand column:\n tensor([[4],\n        [4],\n        [1]])\n8. Squared values:\n tensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n   Original x unchanged:\n tensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n9. Tensor y (2x3):\n tensor([[2, 2, 1],\n        [4, 1, 0]])\n10. Matrix product prod (3x3):\n tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\n"},"children":[],"key":"a2aWTwKJvP"}],"key":"AMLFcncoZz"}],"key":"i38FipLK9D"}],"key":"hSJFAVxBDg"},"references":{"cite":{"order":[],"data":{}}}}