TnbzqvZP"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Create a NumPy array called \"arr\" that contains 6 random integers between 0 (inclusive) and 5 (exclusive), call the ","key":"UayaiOyOZv"},{"type":"inlineCode","value":"set_seed()","key":"v0OPC2HYSH"},{"type":"text","value":" function and use ","key":"tJoUmfv3uI"},{"type":"inlineCode","value":"42","key":"bs2k4EMq3K"},{"type":"text","value":" as the seed parameter.","key":"kDrA3IQ9oV"}],"key":"sv13vp8rs7"}],"key":"MPAZRjFVCE"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Create a tensor \"x\" from the array above","key":"lxpGTU2eLg"}],"key":"KEi9OUw67H"}],"key":"r54q1i3ldQ"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Change the dtype of x from ","key":"zqMoqWjEg6"},{"type":"inlineCode","value":"int32","key":"s3ZvVn5GH7"},{"type":"text","value":" to ","key":"YeA8NmmnUB"},{"type":"inlineCode","value":"int64","key":"mzjtUHqnTt"}],"key":"b6a8X0Z92I"}],"key":"i1AwFXyt43"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Reshape ","key":"UgtaYogEcA"},{"type":"inlineCode","value":"x","key":"DSxDGfvMGg"},{"type":"text","value":" into a 3x2 tensor","key":"Bhjvw66any"}],"key":"qQ4WUYnVFu"}],"key":"nnmiLFm9RR"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Return the right-hand column of tensor ","key":"ONPDc9wqAD"},{"type":"inlineCode","value":"x","key":"KN56m6hHss"}],"key":"dlRZe4r5Yl"}],"key":"cnFlQoKc35"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Without changing x, return a tensor of square values of ","key":"Pb6R8giqOO"},{"type":"inlineCode","value":"x","key":"Y0EVyjNz17"}],"key":"PvYkewsJ3h"}],"key":"KhMZLwP0mr"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Create a tensor ","key":"eiy0D48kAN"},{"type":"inlineCode","value":"y","key":"KOPjz9XhN7"},{"type":"text","value":" with the same number of elements as ","key":"T0Kgc8KL2l"},{"type":"inlineCode","value":"x","key":"qVT9HGlMoT"},{"type":"text","value":", that can be matrix-multiplied with ","key":"g8RprqEvhh"},{"type":"inlineCode","value":"x","key":"aGSFY0wj0T"},{"type":"text","value":" (seed 42)","key":"q4VlTm9PD6"}],"key":"CoYVbwmdCi"}],"key":"Ku3DYX30D4"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Find the matrix product of ","key":"QLLfdFNcF6"},{"type":"inlineCode","value":"x","key":"Eaax0GHVdz"},{"type":"text","value":" and ","key":"jWulk50Z3B"},{"type":"inlineCode","value":"y","key":"Em4ALFdHSw"},{"type":"text","value":".","key":"AtZGF7ZaFc"}],"key":"G0HGF37yww"}],"key":"l2qYkVHR3C"}],"key":"MITPZsx7bU"}],"key":"YT6uxEkCUK"},{"type":"heading","depth":2,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Code Implementation","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"lFebqBfFK3"}],"identifier":"code-implementation","label":"Code Implementation","html_id":"code-implementation","implicit":true,"key":"mNIpGQfNGx"}],"key":"KgkaJnMtOU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 1. Perform Standard Imports\nimport torch\nimport numpy as np\n\n# 2. Create set_seed() function\ndef set_seed(seed: int):\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n\n# 3. Create a NumPy array 'arr' of 6 random integers between 0 and 5\nset_seed(42)\narr = np.random.randint(0, 5, 6)\nprint(\"3. NumPy array 'arr':\", arr)\n\n# 4. Create tensor x from array\nx = torch.from_numpy(arr)\nprint(\"4. Tensor x:\", x)\n\n# 5. Change dtype of x from int32 to int64\nprint(\"5. Old Type:\", x.type())\nx = x.type(torch.int64)\nprint(\"   New Type:\", x.type())\n\n# 6. Reshape x into a 3x2 tensor\nx = x.reshape(3, 2)\nprint(\"6. Reshaped x (3x2):\\n\", x)\n\n# 7. Return the right-hand column of tensor x\nprint(\"7. Right-hand column:\\n\", x[:, 1:])\n\n# 8. Without changing x, return a tensor of square values of x\nx_squared = x.pow(2)\nprint(\"8. Squared values:\\n\", x_squared)\nprint(\"   Original x unchanged:\\n\", x)\n\n# 9. Create tensor y with shape (2, 3) to permit matrix multiplication with x (3, 2)\nset_seed(42)\ny = torch.randint(0, 5, (2, 3))\nprint(\"9. Tensor y (2x3):\\n\", y)\n\n# 10. Find the matrix product of x and y.\nprod = torch.mm(x, y)\nprint(\"10. Matrix product prod (3x3):\\n\", prod)","key":"BryxGHXpRd"},{"type":"outputs","id":"p5Rf078k2x9gOyNpz3-9-","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"3. NumPy array 'arr': [3 4 2 4 4 1]\n4. Tensor x: tensor([3, 4, 2, 4, 4, 1], dtype=torch.int32)\n5. Old Type: torch.IntTensor\n   New Type: torch.LongTensor\n6. Reshaped x (3x2):\n tensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n7. Right-hand column:\n tensor([[4],\n        [4],\n        [1]])\n8. Squared values:\n tensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n   Original x unchanged:\n tensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n9. Tensor y (2x3):\n tensor([[2, 2, 1],\n        [4, 1, 0]])\n10. Matrix product prod (3x3):\n tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\n"},"children":[],"key":"VVYa9jTK8F"}],"key":"WCBTyOGcuX"}],"key":"hfsVPTahic"}],"key":"xO1pt22v0m"},"references":{"cite":{"order":[],"data":{}}}}