}],"key":"tv02L35L9A"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Create a tensor ","key":"JpIPaLAlXM"},{"type":"inlineCode","value":"y","key":"NfLms5NcT6"},{"type":"text","value":" with the same number of elements as ","key":"TQqBy7dccf"},{"type":"inlineCode","value":"x","key":"we6GsrRLj0"},{"type":"text","value":", that can be matrix-multiplied with ","key":"HMnwZNG1av"},{"type":"inlineCode","value":"x","key":"XZj8kR7hls"},{"type":"text","value":" (seed 42)","key":"HhxXpwDQLw"}],"key":"B4Y0pPXFcz"}],"key":"aTVZUELlvZ"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Find the matrix product of ","key":"ZWaUqnH5yX"},{"type":"inlineCode","value":"x","key":"uTCMBEZYdu"},{"type":"text","value":" and ","key":"kCSX6vq6AQ"},{"type":"inlineCode","value":"y","key":"B5r2F67bBa"},{"type":"text","value":".","key":"xVJiPSHzlm"}],"key":"buwTuyxtGG"}],"key":"nRpR5SxWgj"}],"key":"bxnuy4He89"}],"key":"yDQRh7Welt"},{"type":"heading","depth":2,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Code Implementation","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"EbHr1q8pPk"}],"identifier":"code-implementation","label":"Code Implementation","html_id":"code-implementation","implicit":true,"key":"kZVr0vccRv"}],"key":"vpEDw7oSfR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 1. Perform Standard Imports\nimport torch\nimport numpy as np\n\n# 2. Create set_seed() function\ndef set_seed(seed: int):\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n\n# 3. Create a NumPy array 'arr' of 6 random integers between 0 and 5\nset_seed(42)\narr = np.random.randint(0, 5, 6)\nprint(\"3. NumPy array 'arr':\", arr)\n\n# 4. Create tensor x from array\nx = torch.from_numpy(arr)\nprint(\"4. Tensor x:\", x)\n\n# 5. Change dtype of x from int32 to int64\nprint(\"5. Old Type:\", x.type())\nx = x.type(torch.int64)\nprint(\"   New Type:\", x.type())\n\n# 6. Reshape x into a 3x2 tensor\nx = x.reshape(3, 2)\nprint(\"6. Reshaped x (3x2):\\n\", x)\n\n# 7. Return the right-hand column of tensor x\nprint(\"7. Right-hand column:\\n\", x[:, 1:])\n\n# 8. Without changing x, return a tensor of square values of x\nx_squared = x.pow(2)\nprint(\"8. Squared values:\\n\", x_squared)\nprint(\"   Original x unchanged:\\n\", x)\n\n# 9. Create tensor y with shape (2, 3) to permit matrix multiplication with x (3, 2)\nset_seed(42)\ny = torch.randint(0, 5, (2, 3))\nprint(\"9. Tensor y (2x3):\\n\", y)\n\n# 10. Find the matrix product of x and y.\nprod = torch.mm(x, y)\nprint(\"10. Matrix product prod (3x3):\\n\", prod)","key":"bwNt0qewQm"},{"type":"outputs","id":"kbGlQpGabvXH19rIT39hs","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"3. NumPy array 'arr': [3 4 2 4 4 1]\n4. Tensor x: tensor([3, 4, 2, 4, 4, 1], dtype=torch.int32)\n5. Old Type: torch.IntTensor\n   New Type: torch.LongTensor\n6. Reshaped x (3x2):\n tensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n7. Right-hand column:\n tensor([[4],\n        [4],\n        [1]])\n8. Squared values:\n tensor([[ 9, 16],\n        [ 4, 16],\n        [16,  1]])\n   Original x unchanged:\n tensor([[3, 4],\n        [2, 4],\n        [4, 1]])\n9. Tensor y (2x3):\n tensor([[2, 2, 1],\n        [4, 1, 0]])\n10. Matrix product prod (3x3):\n tensor([[22, 10,  3],\n        [20,  8,  2],\n        [12,  9,  4]])\n"},"children":[],"key":"UAAmSmlhal"}],"key":"xT2PBd89h1"}],"key":"Ap0lrO93hm"}],"key":"moI4DCHScN"},"references":{"cite":{"order":[],"data":{}}}}